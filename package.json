{
  "name": "last-line",
  "productName": "Останній рубіж",
  "version": "1.0.0",
  "description": "Кооперативна оборона позиції на 3 гравців: сучасна війна, сезони, погода, прокачка",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/standalone.js",
    "dist": "node scripts/vendor-three.mjs && electron-builder --win portable zip",
    "postinstall": "node scripts/vendor-three.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.1",
    "electron": "37.2.0",
    "electron-builder": "25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "ua.lastline.game",
    "productName": "LastLine",
    "files": [
      "electron/**",
      "server/**",
      "shared/**",
      "client/**",
      "package.json",
      "!client/assets/models/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "portable": {
      "artifactName": "LastLine-${version}-portable.exe"
    }
  },
  "author": "Last Line"
}
